<CodeSnippet Format="1.0.0">
  <Header>
    <Title>c arr2d</Title>
    <Shortcut>c arr2d</Shortcut>
    <Description>My custom C++ function template</Description>
    <Author>James Wang</Author>
  </Header>
  <Snippet>
    <Declarations>
      <Literal>
        <ID>type</ID>
        <Default>int</Default>
      </Literal>
      <Literal>
        <ID>name</ID>
        <Default>MyFunction</Default>
      </Literal>
    </Declarations>
    <Code Language="CPP">
      <![CDATA[
#include <signal.h>
#include <stdio.h>
#include <unistd.h>
struct foo { // non-atomic access
    long a; long b;  //8*2=16
} x = {0,0}; //x.a=x.b=0
void handler(int signo){
    printf("%ld , %ld\n", x.a, x.b);
    alarm(1);
}
int main(void){
    struct foo zeros = {0,0}, ones={1,1};
    signal(SIGALRM, handler);
    alarm(1);
    while(1) {
        x = zeros;
        x = ones;
    }
    return 0;
}
      ]]>
    </Code>
  </Snippet>
</CodeSnippet>