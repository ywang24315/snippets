<CodeSnippet Format="1.0.0">
  <Header>
    <Title>pointers</Title>
    <Shortcut>pointers</Shortcut>
    <Description>My custom C++ function template</Description>
    <Author>James Wang</Author>
  </Header>
  <Snippet>
    <Declarations>
      <Literal>
        <ID>type</ID>
        <Default>int</Default>
      </Literal>
      <Literal>
        <ID>name</ID>
        <Default>MyFunction</Default>
      </Literal>
    </Declarations>
    <Code Language="CPP">
      <![CDATA[
        #include <stdio.h>
        int main(void)
        {
            const char* m1= "a string literal";
            const char* m2= m1;
            printf("%s %p %p\n",m1, &m1,m1);
            printf("%s %p %p\n",m2, &m2,m2);
            return 0;
        }
      ]]>
    </Code>
  </Snippet>
</CodeSnippet>